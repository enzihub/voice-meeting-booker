# Copy to .env.local and fill in. Every value is blank by default.

# --- VAPI (https://vapi.ai) ---
VAPI_API_KEY=
# One assistant per mode, or a single fallback in VAPI_ASSISTANT_ID
VAPI_ASSISTANT_ID=
VAPI_ASSISTANT_ID_MEETING_BOOKER=
VAPI_ASSISTANT_ID_SDR=
VAPI_ASSISTANT_ID_REMINDER=
# Default caller line (a VAPI phone-number id)
VAPI_PHONE_NUMBER_ID=
# Optional: JSON list of caller lines shown in Settings
# [{"phone_id":"<vapi phone-number id>","number":"+1 (555) 010-0100","label":"Main Office"}]
VAPI_PHONE_NUMBERS=
# Optional: JSON list of voices shown in Settings (ElevenLabs voice ids)
# [{"voice_id":"<11labs voice id>","voicename":"Billy","preview_audio":"","tags":["Male","Casual"],"default":true}]
VAPI_VOICES=
# Optional: shared secret VAPI sends as x-vapi-secret to the webhook
VAPI_WEBHOOK_SECRET=
# Optional: override the API base (used by the local demo fake)
VAPI_BASE_URL=

# --- OpenAI (slot extraction from the transcript) ---
OPENAI_API_KEY=
OPENAI_MODEL=
BOOKING_TIMEZONE=
